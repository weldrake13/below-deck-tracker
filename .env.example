# Copy to .env and fill in. .env is git-ignored — never commit real credentials.

# Port the app is published on locally / on the server. 3100, not 3000 — this
# runs alongside the jessica-jade site on the same box, which already owns 3000.
HTTP_PORT=3100

# ---------------------------------------------------------------------------
# Live tracking (optional).
#
# Get a free key at https://aisstream.io (sign up, then "API Keys" in your
# account). Leave it blank and the app still runs: the yacht list, filters
# and map all work, positions are just shown as "not currently tracked".
# ---------------------------------------------------------------------------
AISSTREAM_API_KEY=
