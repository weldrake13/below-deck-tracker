{
  "name": "below-deck-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Tracks the real yachts behind the Below Deck TV franchise, live, on a nautical chart",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}
